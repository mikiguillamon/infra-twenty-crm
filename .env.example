# Example for STAGING. Set actual secret values in Coolify, never in Git.
# Validated target image. Upgrade only after staging smoke/regression tests.
TWENTY_IMAGE_TAG=v2.48.0
TWENTY_STACK_ID=stage
TWENTY_ROOT_DOMAIN=twenty-stage.justforfun.es
TWENTY_ROUTER_HOST_REGEX=[a-z0-9-]+\.twenty-stage\.justforfun\.es
SERVER_URL=https://twenty-stage.justforfun.es

# Private internal URL from your standalone Coolify PostgreSQL 16 resource.
# Generate a hex password to avoid URI-special-character parsing.
PG_DATABASE_URL=postgresql://twenty:REPLACE_WITH_PASSWORD@postgres-on-coolify:5432/twenty
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
# Empty except when following the upstream encryption key rotation procedure.
FALLBACK_ENCRYPTION_KEY=
